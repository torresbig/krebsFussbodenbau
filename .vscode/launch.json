{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Launch Chrome (website)",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start website server"
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Chromium (NAS)",
            "address": "127.0.0.1",
            "port": 9222,
            "webRoot": "${workspaceFolder}"
        }
    ]
}